{
  "id": "affect-core",
  "name": "Affect Core",
  "description": "Pet-like sustainable cultivation plus an inertial, bounded affect layer. Local review build.",
  "version": "0.3.0-pet-review",
  "main": "./src/index.ts",
  "activation": { "onStartup": true },
  "openclaw": {
    "minVersion": "2026.7.1",
    "extensions": ["./src/index.ts"],
    "compat": { "pluginApi": ">=2026.3.23" }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "stateDir": { "type": "string" },
      "maxIntensity": { "type": "integer", "minimum": 0, "maximum": 3, "default": 2 },
      "personality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "openness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
          "conscientiousness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
          "extraversion": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 },
          "agreeableness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
          "neuroticism": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 }
        }
      },
      "care": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tz": { "type": "string", "default": "Asia/Shanghai" },
          "dailyFamiliarityCap": { "type": "number", "minimum": 0, "maximum": 0.2, "default": 0.022 },
          "dailyAffectionCap": { "type": "number", "minimum": 0, "maximum": 0.2, "default": 0.016 }
        }
      },
      "l1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "maxRatePerHour": { "type": "integer", "minimum": 0, "maximum": 120, "default": 12 },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000, "default": 1500 }
        }
      },
      "proactive": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "quietHours": {
            "type": "array",
            "items": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "minItems": 2,
            "maxItems": 2,
            "default": ["23:30", "08:00"]
          },
          "tz": { "type": "string", "default": "Asia/Shanghai" }
        }
      }
    }
  }
}
