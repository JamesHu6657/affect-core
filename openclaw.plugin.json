{
  "id": "affect-core",
  "name": "Affect Core",
  "description": "Pet-like sustainable cultivation plus an inertial, bounded affect layer. Local review build.",
  "version": "0.3.2",
  "main": "./src/index.ts",
  "activation": { "onStartup": true },
  "openclaw": {
    "minVersion": "2026.7.1",
    "extensions": ["./src/index.ts"],
    "compat": { "pluginApi": ">=2026.3.23" }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "stateDir": { "type": "string" },
      "ownerIds": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Telegram/user ids allowed to run /mood off|on|reset. Empty = allow all (private bot)."
      },
      "careMigrateTo": {
        "type": "string",
        "description": "If leftover global care cannot be assigned, copy it to this userId."
      },
      "maxIntensity": { "type": "integer", "minimum": 0, "maximum": 3, "default": 2 },
      "moodCoupling": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.25 },
      "tau": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "v": { "type": "number", "exclusiveMinimum": 0, "default": 55 },
          "a": { "type": "number", "exclusiveMinimum": 0, "default": 14 },
          "d": { "type": "number", "exclusiveMinimum": 0, "default": 70 },
          "mood": { "type": "number", "exclusiveMinimum": 0, "default": 900 }
        }
      },
      "personality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "openness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
          "conscientiousness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
          "extraversion": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 },
          "agreeableness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
          "neuroticism": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 }
        }
      },
      "care": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tz": { "type": "string", "default": "Asia/Shanghai" },
          "dailyFamiliarityCap": { "type": "number", "minimum": 0, "maximum": 0.2, "default": 0.022 },
          "dailyAffectionCap": { "type": "number", "minimum": 0, "maximum": 0.2, "default": 0.016 }
        }
      },
      "l1": {
        "type": "object",
        "additionalProperties": false,
        "description": "Experimental. Keyword stub only, not an LLM. Default off. Most cue words are already handled by L0.",
        "properties": {
          "enabled": { "type": "boolean", "default": false, "description": "Leave false unless you are testing the experimental L1 stub." },
          "maxRatePerHour": { "type": "integer", "minimum": 0, "maximum": 120, "default": 12 },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000, "default": 1500 }
        }
      },
      "proactive": {
        "type": "object",
        "additionalProperties": false,
        "description": "Suggestion only. Heartbeat never sends outbound messages and does not advance lastProactiveAt.",
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "quietHours": {
            "type": "array",
            "items": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "minItems": 2,
            "maxItems": 2,
            "default": ["23:30", "08:00"]
          },
          "tz": { "type": "string", "default": "Asia/Shanghai" }
        }
      }
    }
  }
}
