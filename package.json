{
  "name": "openclaw-affect-core",
  "version": "0.2.0-review",
  "type": "module",
  "description": "An inertial, explainable, bounded affect layer for OpenClaw agents. It changes only how the agent speaks, never what it can do.",
  "license": "MIT",
  "author": "James Hu (https://github.com/JamesHu6657)",
  "homepage": "https://github.com/JamesHu6657/affect-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesHu6657/affect-core.git"
  },
  "bugs": {
    "url": "https://github.com/JamesHu6657/affect-core/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "affect",
    "emotion",
    "pad-model",
    "appraisal",
    "agent",
    "llm"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.23"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
